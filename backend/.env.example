# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
MAX_LLM_ATTEMPTS=3

# 文本预算
MAX_TRANSCRIPT_CHARS=12000
MAX_OCR_CHARS=6000
MAX_TOTAL_INPUT_CHARS=24000

# 存储
DATABASE_URL=sqlite:///./data/knowledgeflow.db
DOWNLOAD_DIR=./data/media

# Obsidian
OBSIDIAN_VAULT_PATH=

# 抖音采集（第二十九条：只填你自己账号的登录态；留空 = 匿名访问，大概率撞验证页）
# 形如：DOUYIN_COOKIE=sessionid=xxxx; ttwid=yyyy
# 敏感串：不会回显到 /api/health，也不会进日志
DOUYIN_COOKIE=

# 任务
TASK_RESET_TIMEOUT_SECONDS=900

# 日志
LOG_LEVEL=INFO
LOG_VERBOSE_CONTENT=0
